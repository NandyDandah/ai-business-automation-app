# Generate these with python -m app.security
APP_ENV=development
APP_PASSWORD_HASH=
APP_SESSION_SECRET=
APP_API_TOKEN_HASH=
APP_COOKIE_SECURE=false
# Local development uses SQLite. On Render, set DATABASE_URL privately to the
# Render Postgres internal URL; never commit a real connection string.
DATABASE_URL=sqlite:///./automation.db

# Optional: powers campaign draft writing. Drafts are never sent automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible API base URL; defaults to https://api.openai.com/v1.
OPENAI_BASE_URL=

# Campaign Studio uses user-triggered, cached OpenStreetMap searches.
# Nominatim is limited to one request/second and user-initiated lookups only.
# Overpass chooses the DResel Europe instance for European places and the global
# Private.coffee instance elsewhere. Searches are limited and cached; review the
# providers' current terms and use a managed/self-hosted service at higher volume.
OSM_CONTACT_EMAIL=
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=

# Optional public UK retrofit enquiry pilot. The form stays closed unless all
# details are supplied and PUBLIC_ENQUIRY_ENABLED is explicitly set to true.
PUBLIC_ENQUIRY_ENABLED=false
PUBLIC_ENQUIRY_CONTROLLER_NAME=
PUBLIC_ENQUIRY_CONTACT_EMAIL=
PUBLIC_ENQUIRY_PRIVACY_URL=
PUBLIC_ENQUIRY_RETENTION_DAYS=
PUBLIC_ENQUIRY_CLOSE_AT=
